# Required
DATABASE_URL=            # Postgres (Neon / Vercel Postgres / Supabase). e.g. postgres://user:pass@host/db?sslmode=require
SESSION_SECRET=          # long random string (openssl rand -hex 32)

# Optional
RUN_MIGRATIONS=          # "true" = apply db/migrations during Vercel build
TRIAL_MONTHS=2           # free trial from sign-up
HOLD_MONTHS=6            # months on hold before data purge (patient name/phone/address kept)
CRON_SECRET=             # REQUIRED for /api/cron/lifecycle (fails closed without it)
# LLM_API_URL= LLM_API_KEY= LLM_MODEL=   # optional assistant Q&A (OpenAI-compatible)
# RESEND_API_KEY=                        # optional: email lifecycle warnings
ALLOW_PUBLIC_SIGNUP=     # "false" closes /onboarding

# Razorpay subscription billing (leave empty until you have a Razorpay account; webhook returns 503 until set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (optional, "call patient" messages)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# Only for the CLI scripts (not needed in Vercel)
# HOSPITAL_NAME= HOSPITAL_CODE= ADMIN_EMAIL= ADMIN_NAME= ADMIN_PASSWORD=
# PLATFORM_ADMIN_EMAIL= PLATFORM_ADMIN_PASSWORD=
